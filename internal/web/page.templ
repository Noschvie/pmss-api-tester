package web

templ Page(state PageState) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>PMSS API Tester</title>
			<link rel="preload" href="/static/geist-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/static/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<div class="app-shell">
				<aside class="sidebar" aria-label="Main navigation">
					<a class="brand" href="/" aria-label="PMSS API Tester home">
						<span class="brand-mark" aria-hidden="true">P</span>
						<span class="brand-copy"><strong>PMSS</strong><small>API Tester</small></span>
					</a>
					<div class="nav-caption">WORKSPACE</div>
					<nav>
						<a class="nav-item active" href="/" aria-current="page">
							<span class="nav-icon" aria-hidden="true">▦</span><span>Overview</span>
						</a>
						<a class="nav-item" href="/api-explorer">
							<span class="nav-icon" aria-hidden="true">⌘</span><span>API Explorer</span>
						</a>
						<a class="nav-item" href="/checks">
							<span class="nav-icon" aria-hidden="true">✓</span><span>Checks</span>
						</a>
					</nav>
					<div class="sidebar-bottom">
						<div class="sidebar-rule"></div>
						<div class="version-label">VERSION 1 · READ-ONLY</div>
					</div>
				</aside>
				<main class="main-content">
					<header class="topbar">
						<div class="breadcrumbs"><span>PMSS API Tester</span><span class="crumb-separator">/</span><strong>Overview</strong></div>
						<div class="topbar-actions">
							if state.AuthEnabled {
								if state.Authenticated {
									<span class="user-label">{ state.Username }</span>
									<form method="post" action="/auth/logout">
										<input type="hidden" name="csrf_token" value={ state.CSRFToken }/>
										<button class="logout-button" type="submit">Log out</button>
									</form>
								} else {
									<a class="login-button" href="/auth/login">Sign in with Keycloak</a>
								}
							}
							<button class="theme-toggle" type="button" aria-label="Toggle color scheme" title="Toggle color scheme">
								<span class="theme-light" aria-hidden="true">☼</span><span class="theme-dark" aria-hidden="true">◐</span>
							</button>
						</div>
					</header>
					<div class="page-body">
						<div class="page-heading">
							<div>
								<div class="eyebrow">MQTT SECURITY SERVICE</div>
								<h1>Overview</h1>
								<p class="subtitle">API connectivity and specification status at a glance.</p>
							</div>
							<div class="readonly-badge"><span class="lock-icon" aria-hidden="true">▣</span> Read-only</div>
						</div>
						<section class="status-grid" aria-label="System status">
							<article class="status-card">
								<div class="card-topline"><span>Tester status</span><span class="card-symbol green" aria-hidden="true">●</span></div>
								<div class="card-value" hx-get="/_ui/backend-status" hx-trigger="load" hx-swap="innerHTML">
									<span class="loading-dot"></span> Checking
								</div>
								<div class="card-note">Local application status</div>
							</article>
							<article class="status-card">
								<div class="card-topline"><span>Target system</span><span class="card-symbol blue" aria-hidden="true">◎</span></div>
								if state.PMSSConfigured {
									<div class="card-value"><a class="target-link" href="/api-explorer">{ state.PMSSAPIBaseURL }</a></div>
									<div class="card-note">Target system · <a href="/api-explorer">Open API Explorer</a></div>
								} else {
									<div class="card-value">Not configured</div>
									<div class="card-note"><a href="/api-explorer">Configure target and API Explorer</a></div>
								}
							</article>
							<article class="status-card">
								<div class="card-topline"><span>API specification</span><span class="card-symbol blue" aria-hidden="true">⌗</span></div>
								<div class="card-value">Version 1.0</div>
								<div class="card-note">OpenAPI 3.2.1 · validated at startup</div>
							</article>
						</section>
						if state.Error != "" {
							<div class="auth-message auth-error" role="alert">{ state.Error }</div>
						}
						if !state.AuthEnabled {
							<section class="auth-panel">
								<div class="eyebrow">KEYCLOAK SIGN-IN</div>
								<h2>OIDC is not configured yet</h2>
								<p>Configure the issuer, client ID, and client secret for the integration Keycloak to enable sign-in and server-side token exchange.</p>
							</section>
						} else if state.Authenticated {
							<section class="auth-panel">
								<div class="eyebrow">SIGNED-IN USER</div>
								<h2>{ state.Username }</h2>
								<p>Scope requested for PMSS: <code>read</code>. Scopes actually returned: <code>{ state.ScopeLabel }</code>.</p>
								if state.HasReadScope {
									<div class="auth-status auth-status-good"><span class="status-indicator"></span> Read permission granted · session expires { state.ExpiresAt }</div>
								} else {
									<div class="auth-status auth-status-blocked"><span aria-hidden="true">!</span> BLOCKED · Token exchange did not return the <code>read</code> scope.</div>
								}
							</section>
						} else {
							<section class="auth-panel">
								<div class="eyebrow">KEYCLOAK SIGN-IN</div>
								<h2>Sign in with your account</h2>
								<p>Sign-in uses the Authorization Code Flow with PKCE. Tokens remain server-side; only the <code>read</code> scope is requested for PMSS.</p>
								<a class="login-button" href="/auth/login">Sign in with Keycloak</a>
							</section>
						}
						<section class="welcome-card">
							<div class="welcome-copy">
								<div class="eyebrow">PROJECT FOUNDATION</div>
								<h2>Secure sign-in with Keycloak</h2>
								<p>Sign-in uses server-side PKCE. PMSS access tokens are exchanged for the configured audience and remain exclusively in the backend.</p>
							</div>
							<div class="welcome-art" aria-hidden="true">
								<div class="art-ring ring-one"></div><div class="art-ring ring-two"></div>
								<div class="art-center"><span>API</span><i>✓</i></div>
								<div class="art-node node-one"></div><div class="art-node node-two"></div><div class="art-node node-three"></div>
							</div>
						</section>
						<section class="info-panel">
							<div class="panel-heading"><div><div class="eyebrow">SECURITY MODE</div><h2>Strictly read-only</h2></div><span class="shield-icon" aria-hidden="true">◈</span></div>
							<p>Version 1 only makes read-only API calls. Write operations are blocked server-side and are not part of this prototype.</p>
							<div class="panel-footer"><span class="status-indicator"></span> Write operations are disabled</div>
						</section>
						<footer class="page-footer">PMSS API Tester <span>·</span> Version 1 <span>·</span> TasmoFleet product family</footer>
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ BackendStatus() {
	<span class="inline-status"><span class="status-indicator"></span> Ready</span>
}
