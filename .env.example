# Copy this file to .env and replace the placeholder with the Keycloak client secret.
# Compose reads .env automatically. Never commit the populated .env file.
PMSS_API_BASE_URL=https://pmss.example.org
# Only for isolated test environments; HTTP sends access tokens unencrypted.
PMSS_ALLOW_INSECURE_HTTP=false
OIDC_ISSUER_URL=http://127.0.0.1:8180/realms/pmss-test
OIDC_INTERNAL_URL=
OIDC_CLIENT_ID=pmss-api-tester
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_CALLBACK_URL=http://127.0.0.1:8080/auth/callback
# Set to true when serving the tester over HTTPS.
OIDC_COOKIE_SECURE=false
PMSS_AUDIENCE=phylax-mqtt-security-service
